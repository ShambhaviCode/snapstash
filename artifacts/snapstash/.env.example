# RevenueCat public SDK keys. See "Environment variables" in the README.
# Used in development, Expo Go and web (without it the app runs on the free plan):
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
# Optional, used by production store builds (fall back to the test key):
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
